# Copy to .env.local to override. See docs/IMPLEMENTATION_PLAN.md F0.
VITE_API_URL=
VITE_WS_URL=
# true = in-browser MSW mock backend (FieldOps demo data)
VITE_USE_MOCKS=true
# Empty authority = local dev session without OIDC.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=platon-studio
VITE_CONSTRUCTOR_ORIGIN=http://localhost:5174
# Platon Sandbox (platon-sandbox repo) — renders the app in an iframe for the canvas and Preview.
VITE_SANDBOX_URL=http://localhost:5175
